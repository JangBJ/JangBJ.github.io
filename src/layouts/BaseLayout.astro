---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  /** <title> 앞부분. 비우면 사이트 이름만 들어갑니다. */
  title?: string;
  /** 메타 설명. 비우면 site.description */
  description?: string;
  /** 본문 최대 폭을 글 읽기 폭으로 좁힙니다 */
  narrow?: boolean;
}

const { title, description = site.description, narrow = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://JangBJ.github.io');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    {/*
      테마를 body 렌더 전에 확정해 깜빡임을 막습니다.
      기본은 다크. 저장된 선택이 있으면 그것을 따릅니다.
      시스템 설정을 따르게 하려면 아래 'dark' 를
      (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') 로 바꾸세요.
    */}
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {
          /* 프라이빗 모드 등에서 localStorage 접근이 막히면 기본값을 씁니다 */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main" class:list={['main', { narrow }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main {
    flex: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .main.narrow {
    max-width: calc(var(--prose-width) + var(--space-5) * 2);
  }

  @media (max-width: 40rem) {
    .main {
      padding: var(--space-5) var(--space-4) var(--space-7);
    }
  }
</style>
