---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, readingTime, splitChapterId, visible } from '../../../lib/content';

export async function getStaticPaths() {
  const [projects, allChapters] = await Promise.all([
    getCollection('projects'),
    getCollection('chapters'),
  ]);

  // draft 는 프로덕션에서 페이지 자체를 만들지 않습니다.
  // (목록에서만 빼면 URL 을 아는 사람은 그대로 열 수 있습니다)
  return projects.filter(visible).flatMap((project) => {
    const chapters = allChapters
      .filter((c) => visible(c) && splitChapterId(c.id).project === project.id)
      .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id, 'ko'));

    return chapters.map((chapter, i) => ({
      params: { project: project.id, chapter: splitChapterId(chapter.id).chapter },
      props: {
        chapter,
        project,
        index: i + 1,
        total: chapters.length,
        prev: chapters[i - 1] ?? null,
        next: chapters[i + 1] ?? null,
      },
    }));
  });
}

const { chapter, project, index, total, prev, next } = Astro.props;
const { Content } = await render(chapter);

const mins = readingTime(chapter.body);
const date = formatDate(chapter.data.date);
const num = String(index).padStart(2, '0');

const hrefOf = (c: typeof chapter) => `/projects/${project.id}/${splitChapterId(c.id).chapter}/`;
---

<BaseLayout title={chapter.data.title} description={chapter.data.description} narrow>
  <nav class="crumbs" aria-label="현재 위치">
    <a href="/">~</a>
    <span class="slash" aria-hidden="true">/</span>
    <a href={`/projects/${project.id}/`}>{project.id}</a>
    <span class="slash" aria-hidden="true">/</span>
    <span class="here">{num}</span>
  </nav>

  <article>
    <header class="head">
      <p class="eyebrow">
        <span class="num">{num}</span>
        <span class="of">/ {String(total).padStart(2, '0')}</span>
        {chapter.data.category && <span class="cat">{chapter.data.category}</span>}
      </p>

      <h1>{chapter.data.title}</h1>

      {chapter.data.description && <p class="desc">{chapter.data.description}</p>}

      <p class="meta">
        {date && <span>{date}</span>}
        <span>읽는 데 {mins}분</span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="이전 · 다음 글">
    {
      prev ? (
        <a class="pglink prev" href={hrefOf(prev)}>
          <span class="pgdir">← prev</span>
          <span class="pgtitle">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="pglink next" href={hrefOf(next)}>
          <span class="pgdir">next →</span>
          <span class="pgtitle">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <a class="back" href={`/projects/${project.id}/`}>cd ..</a>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .slash {
    color: var(--faint);
  }

  .here {
    color: var(--accent);
  }

  .head {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-width) solid var(--border);
  }

  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .num {
    color: var(--accent);
    font-weight: 700;
  }

  .of {
    color: var(--faint);
  }

  .cat {
    margin-left: var(--space-2);
    padding: 0.1em 0.5em;
    color: var(--amber);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
    color: var(--text-strong);
  }

  .desc {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .prose {
    margin-top: var(--space-6);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--border);
  }

  .pglink {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color var(--transition),
      background var(--transition);
  }

  .pglink:hover {
    border-color: var(--accent-border);
    background: var(--surface);
  }

  .pglink.next {
    text-align: right;
  }

  .pgdir {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .pgtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-strong);
    line-height: var(--leading-tight);
  }

  .back {
    display: inline-block;
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }

  .back::before {
    content: '$ ';
    color: var(--accent);
  }

  .back:hover {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pglink.next {
      text-align: left;
    }
  }
</style>
