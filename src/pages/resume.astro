---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResume, formatDate } from '../lib/content';
import { site } from '../site.config';

const resume = await getResume();
const d = resume?.data;
---
<!--
  실릴 문서가 없을 때(전부 draft 이거나 파일이 없을 때)는 안내만 띄웁니다.
  방문자에게 작성 경로를 보여 줄 이유는 없으니 개발 중에만 경로를 덧붙입니다.
-->


<BaseLayout
  title={d?.title ?? '경력기술서'}
  description={d?.summary ?? `${site.name} 경력기술서`}
>
  {
    !d ? (
      <p class="empty">
        경력기술서는 준비 중입니다.
        {import.meta.env.DEV && (
          <>
            <br />
            <code>src/content/resume/backend.md</code> 를 채우고 <code>draft</code> 줄을 지우세요.
          </>
        )}
      </p>
    ) : (
      <>
        <header class="head">
          <p class="cmdline">
            <span class="prompt" aria-hidden="true">
              $
            </span>
            <span class="cmd">cat</span>
            <span class="arg">resume.md</span>
          </p>
          <h1>{d.title}</h1>
          {d.summary && <p class="summary">{d.summary}</p>}
          <p class="updated">last updated · {formatDate(d.updated)}</p>
        </header>

        {d.intro.length > 0 && (
          <section class="block" aria-labelledby="intro-heading">
            <h2 id="intro-heading" class="section-label">
              summary
            </h2>
            <ul class="bullets big">
              {d.intro.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </section>
        )}

        {d.skills.length > 0 && (
          <section class="block" aria-labelledby="skills-heading">
            <h2 id="skills-heading" class="section-label">
              skills
            </h2>
            <div class="skills">
              {d.skills.map((group) => (
                <div class="skillcard">
                  <h3>{group.label}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {d.career.length > 0 && (
          <section class="block" aria-labelledby="career-heading">
            <h2 id="career-heading" class="section-label">
              career
            </h2>

            {d.career.map((company) => (
              <div class="company">
                <div class="chead">
                  <div class="ctitle">
                    {company.company && <span class="cname">{company.company}</span>}
                    {company.role && <span class="crole">{company.role}</span>}
                  </div>
                  {company.period && <span class="cperiod">{company.period}</span>}
                </div>
                {company.note && <p class="cnote">{company.note}</p>}

                <div class="projects">
                  {company.projects.map((p) => (
                    <article class="pcard">
                      <div class="pbar">
                        <span class="pname">{p.name}</span>
                        {p.period && <span class="pperiod">{p.period}</span>}
                      </div>

                      <div class="pbody">
                        {p.overview && <p class="poverview">{p.overview}</p>}

                        <dl class="pfacts">
                          {p.role && (
                            <div>
                              <dt>role</dt>
                              <dd>{p.role}</dd>
                            </div>
                          )}
                          {p.team && (
                            <div>
                              <dt>team</dt>
                              <dd>{p.team}</dd>
                            </div>
                          )}
                          {p.stack.length > 0 && (
                            <div>
                              <dt>stack</dt>
                              <dd class="pstack">
                                {p.stack.map((s) => (
                                  <span>{s}</span>
                                ))}
                              </dd>
                            </div>
                          )}
                        </dl>

                        {p.tasks.length > 0 && (
                          <div class="plist">
                            <h4>주요 업무</h4>
                            <ul class="bullets">
                              {p.tasks.map((t) => (
                                <li>{t}</li>
                              ))}
                            </ul>
                          </div>
                        )}

                        {p.outcomes.length > 0 && (
                          <div class="plist">
                            <h4>성과</h4>
                            <ul class="bullets outcome">
                              {p.outcomes.map((o) => (
                                <li>{o}</li>
                              ))}
                            </ul>
                          </div>
                        )}

                        {p.issues.length > 0 && (
                          <div class="plist">
                            <h4>문제 해결</h4>
                            <ul class="bullets issue">
                              {p.issues.map((i) => (
                                <li>{i}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-width) solid var(--border);
  }

  .cmdline {
    display: flex;
    gap: 0.6ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
  }
  .cmd {
    color: var(--magenta);
  }
  .arg {
    color: var(--green);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .summary {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    max-width: var(--prose-width);
  }

  .updated {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .block {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  /* ── 불릿 공통 ──────────────────────────────────────── */

  .bullets {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text);
  }

  .bullets li {
    padding-left: 1.4em;
    position: relative;
  }

  .bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--faint);
  }

  .bullets.big {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    max-width: var(--prose-width);
  }

  .bullets.big li::before {
    color: var(--accent);
  }

  .bullets.outcome li::before {
    content: '+';
    color: var(--green);
    font-weight: 700;
  }

  .bullets.issue li::before {
    content: '!';
    color: var(--amber);
    font-weight: 700;
  }

  /* ── 스킬 ───────────────────────────────────────────── */

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-3);
  }

  .skillcard {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .skillcard h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .skillcard ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    padding: 0;
  }

  .skillcard li {
    padding: 0.1em 0.5em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-bg);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius-sm);
  }

  /* ── 경력 ───────────────────────────────────────────── */

  .company + .company {
    margin-top: var(--space-7);
  }

  .chead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .ctitle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .cname {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-strong);
  }

  .crole {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .cperiod {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .cnote {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .projects {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .pcard {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .pbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
  }

  .pname {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 650;
    color: var(--text-strong);
  }

  .pname::before {
    content: '● ';
    color: var(--accent);
  }

  .pperiod {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .pbody {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .poverview {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--muted);
  }

  .pfacts {
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .pfacts > div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }

  .pfacts dt {
    color: var(--faint);
  }

  .pfacts dt::after {
    content: ':';
  }

  .pfacts dd {
    margin: 0;
    color: var(--text);
  }

  .pstack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }

  .pstack span {
    padding: 0.1em 0.5em;
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-bg);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius-sm);
  }

  .plist {
    display: grid;
    gap: var(--space-2);
  }

  .plist h4 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .empty code {
    color: var(--amber);
  }

  @media (max-width: 40rem) {
    .pfacts > div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  /* 인쇄 — 경력기술서는 PDF 로 뽑는 일이 잦습니다 */
  @media print {
    .pcard,
    .skillcard {
      break-inside: avoid;
    }
  }
</style>
