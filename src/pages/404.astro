---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="요청한 페이지를 찾을 수 없습니다." narrow>
  <div class="wrap">
    <pre class="code" aria-hidden="true">404</pre>

    <p class="line">
      <span class="prompt" aria-hidden="true">$</span>
      <span class="err">zsh: no such file or directory</span>
    </p>

    <p class="msg">요청한 페이지가 없습니다. 주소가 바뀌었거나 삭제되었을 수 있습니다.</p>

    <a class="home" href="/">cd ~</a>
  </div>
</BaseLayout>

<style>
  .wrap {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: var(--space-7);
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 18vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--border-strong);
  }

  .line {
    display: flex;
    gap: 0.6ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .err {
    color: var(--red);
  }

  .msg {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--muted);
  }

  .home {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius);
    background: var(--accent-bg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .home::before {
    content: '$ ';
    color: var(--faint);
  }

  .home:hover {
    background: var(--surface-hover);
  }
</style>
