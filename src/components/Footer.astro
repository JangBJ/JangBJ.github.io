---
import { site } from '../site.config';

const year = new Date().getFullYear();

/** 푸터에는 외부 링크만 (내부 페이지는 헤더에 이미 있습니다) */
const external = site.contacts.filter((c) => !c.href.startsWith('/'));
---

<footer class="footer">
  <div class="inner">
    <p class="line">
      <span class="prompt" aria-hidden="true">$</span>
      <span class="cmd">echo</span>
      <span class="str">"© {year} {site.name}"</span>
    </p>

    <ul class="links">
      {
        external.map((c) => (
          <li>
            <a href={c.href} title={c.value} rel="me noopener">
              {c.label.toLowerCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width) solid var(--border);
    background: var(--surface-sunken);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .line {
    display: flex;
    gap: 0.5ch;
    color: var(--muted);
  }

  .prompt {
    color: var(--accent);
  }
  .cmd {
    color: var(--magenta);
  }
  .str {
    color: var(--green);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
