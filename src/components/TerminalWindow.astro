---
interface Props {
  /** 타이틀바 가운데에 들어갈 텍스트 (보통 파일명이나 명령) */
  title?: string;
  /** 추가 클래스 */
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['window', className]}>
  <div class="bar">
    <span class="dots" aria-hidden="true">
      <i class="dot r"></i><i class="dot a"></i><i class="dot g"></i>
    </span>
    {title && <span class="title">{title}</span>}
    <slot name="bar-end" />
  </div>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .window {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
  }

  .dots {
    display: inline-flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }
  .dot.r {
    background: var(--dot-red);
  }
  .dot.a {
    background: var(--dot-amber);
  }
  .dot.g {
    background: var(--dot-green);
  }

  .title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .body {
    padding: var(--space-5);
  }

  @media (max-width: 40rem) {
    .body {
      padding: var(--space-4);
    }
  }
</style>
