---
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  /** 이 프로젝트에 달린 글 수 */
  chapters: number;
}

const { project, chapters } = Astro.props;
const { title, summary, kind, stack, period, cover, repo } = project.data;

const href = `/projects/${project.id}/`;
/** 칩은 4개까지만. 나머지는 +N 으로 접습니다. */
const shown = stack.slice(0, 4);
const rest = stack.length - shown.length;
---

<article class="card">
  <div class="bar">
    <span class="dots" aria-hidden="true">
      <i class="dot r"></i><i class="dot a"></i><i class="dot g"></i>
    </span>
    <span class="file">{project.id}.md</span>
    {kind && <span class="kind">{kind}</span>}
  </div>

  <a class="hit" href={href}>
    <span class="sr">{title} 자세히 보기</span>
  </a>

  <div class="thumb">
    {
      cover ? (
        <img src={cover} alt="" loading="lazy" decoding="async" width="1200" height="675" />
      ) : (
        /* 커버 이미지가 없을 때. 빈 칸으로 두지 않고 프롬프트 한 줄을 그립니다. */
        <div class="placeholder" aria-hidden="true">
          <span class="ph-prompt">$</span>
          <span class="ph-cmd">open</span>
          <span class="ph-arg">{project.id}</span>
          <span class="ph-cursor" />
        </div>
      )
    }
  </div>

  <div class="body">
    <h2 class="title">{title}</h2>
    <p class="summary">{summary}</p>

    {
      shown.length > 0 && (
        <ul class="stack">
          {shown.map((s) => (
            <li>{s}</li>
          ))}
          {rest > 0 && <li class="more">+{rest}</li>}
        </ul>
      )
    }

    <div class="meta">
      {period && <span class="period">{period}</span>}
      <span class="count">{chapters}개 글</span>
      {
        repo && (
          <a class="repo" href={repo} rel="noopener" title="저장소 열기">
            repo ↗
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  /* 카드 전체가 링크. 내부의 repo 링크만 위로 띄웁니다. */
  .hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
  }

  .dots {
    display: inline-flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }
  .dot {
    width: 0.5625rem;
    height: 0.5625rem;
    border-radius: 50%;
  }
  .dot.r {
    background: var(--dot-red);
  }
  .dot.a {
    background: var(--dot-amber);
  }
  .dot.g {
    background: var(--dot-green);
  }

  .file {
    font-size: var(--text-xs);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .kind {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--amber);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    background: var(--surface-sunken);
    border-bottom: var(--border-width) solid var(--border);
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 커버 없음 — 옅은 격자 위에 프롬프트 한 줄 */
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6ch;
    height: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background-color: var(--surface-sunken);
    background-image:
      radial-gradient(circle at 50% 50%, var(--accent-bg), transparent 70%),
      repeating-linear-gradient(
        0deg,
        transparent 0 15px,
        color-mix(in srgb, var(--text) 3%, transparent) 15px 16px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 15px,
        color-mix(in srgb, var(--text) 3%, transparent) 15px 16px
      );
  }

  .ph-prompt {
    color: var(--accent);
    font-weight: 700;
  }
  .ph-cmd {
    color: var(--magenta);
  }
  .ph-arg {
    color: var(--muted);
  }

  .ph-cursor {
    width: 0.55em;
    height: 1.1em;
    background: var(--accent);
    opacity: 0.6;
  }

  .card:hover .ph-cursor {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .ph-cursor {
      animation: none;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    flex: 1;
  }

  .title {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 650;
    line-height: var(--leading-tight);
    color: var(--text-strong);
    letter-spacing: -0.01em;
  }

  .summary {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    padding: 0;
  }

  .stack li {
    padding: 0.1em 0.5em;
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-bg);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius-sm);
  }

  .stack .more {
    color: var(--faint);
    background: transparent;
    border-color: var(--border);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--border);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .count {
    color: var(--muted);
  }

  .repo {
    position: relative;
    z-index: 2;
    margin-left: auto;
    color: var(--muted);
    text-decoration: none;
  }

  .repo:hover {
    color: var(--accent);
  }
</style>
