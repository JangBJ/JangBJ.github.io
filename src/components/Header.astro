---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site.config';

const path = Astro.url.pathname;

/** '/' 는 정확히 일치할 때만, 나머지는 접두사로 활성 판정 */
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="inner">
    <a class="brand" href="/" aria-label="홈으로">
      <span class="user">{site.handle}</span><span class="at">@</span><span class="host">dev</span>
      <span class="sep">:</span><span class="cwd">~</span>
      <span class="prompt" aria-hidden="true">$</span>
    </a>

    <nav class="nav" aria-label="주요">
      {
        site.nav.map((item) => (
          <a
            class:list={['link', { active: isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-width) solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-3) var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.05em;
    min-width: 0; /* flex 자식의 기본 min-width:auto 때문에 안 줄어드는 것을 막습니다 */
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .user {
    color: var(--green);
  }
  .at,
  .sep {
    color: var(--faint);
  }
  .host {
    color: var(--magenta);
  }
  .cwd {
    color: var(--accent);
  }

  .prompt {
    margin-left: 0.35em;
    color: var(--muted);
  }

  /* 커서 깜빡임 — 브랜드 옆 한 칸 */
  .prompt::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt::after {
      animation: none;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0; /* 내비는 줄이지 않고, 좁아지면 브랜드 쪽을 줄입니다 */
  }

  .link {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--transition),
      background var(--transition);
  }

  .link:hover {
    color: var(--text-strong);
    background: var(--surface-hover);
  }

  .link.active {
    color: var(--accent);
  }

  .link.active::before {
    content: '/';
    color: var(--faint);
  }

  /* 좁아질수록 프롬프트를 단계적으로 줄입니다 — 내비가 잘리는 것보다 낫습니다 */
  @media (max-width: 40rem) {
    .inner {
      padding-inline: var(--space-4);
    }
    .link {
      padding-inline: var(--space-1);
    }
  }

  @media (max-width: 32rem) {
    .host,
    .at {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .sep,
    .cwd {
      display: none;
    }
    .nav {
      gap: var(--space-1);
    }
  }
</style>
